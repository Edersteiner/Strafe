brush   5 0 -6    6 6 6     color 0.5 0.52 0.55
brush  -5 0 -6    5 6 -5    color 0.5 0.52 0.55
brush  -5 0  5    5 6 6     color 0.5 0.52 0.55

# The ceiling, hole in the middle
brush  -5 6 -5   5 6.5 -1   color 0.45 0.45 0.5
brush  -5 6  1   5 6.5  5   color 0.45 0.45 0.5
brush  -5 6 -1  -1 6.5  1   color 0.45 0.45 0.5
brush   1 6 -1   5 6.5  1   color 0.45 0.45 0.5

# The shaft above the hole
